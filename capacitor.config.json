{
  "appId": "com.cappingalpha.app",
  "appName": "CappingAlpha",
  "webDir": "public",
  "ios": {
    "scheme": "CappingAlpha"
  },
  "server": {
    "url": "http://localhost:3013",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0f1117",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "banner",
        "list"
      ]
    }
  },
  "__DEV_SERVER__": "dev only, added by scripts/cap-dev.js — run \"npm run app:prod\" before any release build"
}
